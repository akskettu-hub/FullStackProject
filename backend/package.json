{
  "name": "@mono/backend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsc && node --experimental-transform-types src/index.ts",
    "dev": "concurrently \"tsc --watch\" \"node --watch-path=./src --experimental-transform-types src/index.ts\"",
    "lint": "eslint .",
    "migration:up": "node ./src/utils/runMigrations.ts",
    "migration:down": "node ./src/utils/rollback.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  }
}
